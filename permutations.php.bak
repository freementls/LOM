<?php

$initial_time = getmicrotime();
$array = array('a', 'b', 'c');
print('AllPermutations($array): ');var_dump(AllPermutations($array));
print('AllPermutations(array(\'d\', \'e\'): ');var_dump(AllPermutations(array('d', 'e')));
print('AllPermutations(AllPermutations(array(\'f\', \'g\', \'h\', \'i\', \'j\')): ');var_dump(AllPermutations(array('f', 'g', 'h', 'i', 'j')));
dump_total_time_taken($initial_time);

function AllPermutations($InArray, &$ReturnArray = array(), $InProcessedArray = array()) {
    if(count($InArray) == 1) {
        $ReturnArray[] = array_merge($InProcessedArray, $InArray);
    } else {
        foreach($InArray as $Key=>$value) {
            $CopyArray = $InArray;
            unset($CopyArray[$Key]);
            AllPermutations($CopyArray, $ReturnArray, array_merge($InProcessedArray, array($Key=>$value)));
        }
    }
	return $ReturnArray;
}

function getmicrotime() {
	list($usec, $sec) = explode(' ', microtime());
	return (float)$usec + (float)$sec;
}

function dump_total_time_taken($initial_time) {
	$time_spent = getmicrotime() - $initial_time;
	print('Total time spent: ' . $time_spent . ' seconds.<br>');
}

?>